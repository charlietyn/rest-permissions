{
    "name": "ronu/rest-permissions",
    "description": "Route-based permissions for ronu/rest-generic-class: route permission catalog, channel authorization middleware, effective-permission Gate and Spatie models",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "permissions", "authorization", "spatie", "rest", "rbac"],
    "authors": [
        {
            "name": "charlietyn",
            "email": "charlietyn@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.61.1 || ^13.12.0",
        "ronu/rest-generic-class": "^3.0",
        "spatie/laravel-permission": "^6.21 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9 || ^11.0",
        "phpunit/phpunit": "^11.5.50 || ^12.5.12"
    },
    "suggest": {
        "nwidart/laravel-modules": "Required for module-aware permissions"
    },
    "autoload": {
        "psr-4": {
            "Ronu\\RestPermissions\\": "src/"
        },
        "files": [
            "src/legacy-aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ronu\\RestPermissions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ronu\\RestPermissions\\RestPermissionsServiceProvider"
            ]
        }
    }
}
